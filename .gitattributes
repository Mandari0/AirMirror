* text=auto

# Scripts and patches must keep LF so they work in MSYS2/bash and `patch`
*.sh text eol=lf
*.patch text eol=lf
*.py text eol=lf
*.spec text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows-native files
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
